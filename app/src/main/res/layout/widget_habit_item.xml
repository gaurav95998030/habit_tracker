<?xml version="1.0" encoding="utf-8"?>
<!-- One habit row: tinted icon badge · name (struck through when done) · streak · check. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp">
        <ImageView
            android:id="@+id/widget_item_badge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_badge"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/widget_item_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="11dp"
        android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/widget_item_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_item_fire"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_item_streak_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_item_check_box"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="11dp">
        <ImageView
            android:id="@+id/widget_item_check"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_check_ring"
            android:contentDescription="Mark done today" />
        <ImageView
            android:id="@+id/widget_item_check_mark"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:contentDescription="@null" />
    </FrameLayout>
</LinearLayout>
